# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-your-token-here

# Anthropic API key
ANTHROPIC_API_KEY=sk-ant-your-key-here

# The public base URL where this app is deployed, e.g. https://your-app.onrender.com
# Leave blank for local-only testing.
PUBLIC_BASE_URL=

# Any random string you pick; used as part of the webhook path so randoms
# on the internet can't POST fake Telegram updates to your bot.
WEBHOOK_SECRET=change-me-to-something-random

# Model to use for the agent (see app/config.py for the default)
ANTHROPIC_MODEL=claude-sonnet-4-6
